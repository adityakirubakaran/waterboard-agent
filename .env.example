# Copy to .env.local for local use. On Vercel, add these under Project -> Settings -> Environment Variables.

# Required: Gemini API key (Google AI Studio). Rahnon has the team key.
GEMINI_API_KEY=

# Optional: models (defaults shown)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_REWRITE_MODEL=gemini-flash-lite-latest
# JUDGE_MODEL=gemini-flash-latest
# QUERY_REWRITE=off                 # search with the visitor's words only

# Full-site index (Upstash Vector, Hybrid index: dense "OpenAI text-embedding-3-small" + sparse "BM25").
# Add to Vercel AND to GitHub repo secrets (the "Crawl full site" action writes to it).
# UPSTASH_VECTOR_REST_URL=
# UPSTASH_VECTOR_REST_TOKEN=

# Optional: question log. Add an Upstash Redis database (Vercel -> Storage -> Upstash for Redis)
# and these are set for you. Without them, questions are written to the Vercel runtime logs.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: password for downloading the question log at /api/questions?token=...
# ADMIN_TOKEN=
